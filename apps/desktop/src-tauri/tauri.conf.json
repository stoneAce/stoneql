{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoneQL",
  "version": "0.1.2",
  "identifier": "me.thixpin.stoneql",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StoneQL",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 500
      }
    ],
    "security": {
      "capabilities": [
        "main-window"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
